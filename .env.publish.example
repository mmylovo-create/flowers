# Copy to .env.publish and fill in. Used by `pnpm shop:publish`. Never commit .env.publish.

# Supabase: https://supabase.com/dashboard → New project. Project ref is in the project URL.
SUPABASE_PROJECT_REF=
# Account → Access Tokens
SUPABASE_ACCESS_TOKEN=
# The database password chosen when the project was created
SUPABASE_DB_PASSWORD=

# Telegram: create a bot with @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Vercel: `pnpm dlx vercel login` once, or a token from vercel.com/account/tokens
VERCEL_TOKEN=
# VERCEL_SCOPE=your-team

# Optional
# SITE_URL=https://flowers.example.ru        # your own domain, if attached in Vercel
# OWNER_PASSWORD=                            # otherwise a random one is printed once
# DEFAULT_SHOP=demo                          # which shop opens at the site root
# ANTHROPIC_API_KEY=                         # assistant phrases answers with Claude (facts stay the same)
